// Configura o banco de dados do Supabase como fonte de dados
generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql" // O Supabase usa PostgreSQL
    url      = env("SUPABASE_URL_USERS") // Variável de ambiente configurada no seu .env
}

// Pessoa (registro mestre). E-mails sempre em minúsculas e sem espaços nas
// pontas: um trigger normaliza ao gravar (o código antigo nunca recebe erro
// por maiúsculas) e um CHECK confere. Um endereço pertence a UMA pessoa só,
// somando User.email e UserEmail.email (triggers na migration 1b). Fase expand: as
// tabelas filhas apagam em cascata com a pessoa (o DELETE atual continua
// funcionando) e os campos de autor viram nulo; o Restrict entra numa
// migration de contract depois que a inativação estiver em produção.
model User {
    id              Int            @id @default(autoincrement())
    // Gerado no banco (gen_random_uuid) para valer também em inserts por SQL.
    publicId        String         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    email           String         @unique
    // Nulo = conta sem senha (ex.: só Google, etapa futura).
    password        String?
    name            String?
    cpf             String?        @unique
    // Nulos = sem perfil no Analytics.
    role            UserRole?
    unit            UserUnit?
    status          UserStatus     @default(ACTIVE)
    deactivatedAt   DateTime?
    deactivatedById Int?
    emailVerifiedAt DateTime?
    // Origem do cadastro (CHECK no banco): admin, invite_password,
    // invite_google, migration ou backfill (quem já existia na 1c).
    createdVia      String         @default("admin")

    // Bloqueio por tentativas (por conta): erros na janela de 15 min e,
    // depois de 5, bloqueio até lockedUntil. lockLevel conta os bloqueios
    // seguidos (backoff: 15 min, 30, 1 h... até 24 h); zera ao acertar a senha.
    failedLoginCount   Int       @default(0)
    failedLoginFirstAt DateTime?
    lockedUntil        DateTime?
    lockLevel          Int       @default(0)

    createdAt       DateTime       @default(now())
    updatedAt       DateTime       @updatedAt
    refreshTokens   RefreshToken[]

    deactivatedBy User?  @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: SetNull)
    deactivated   User[] @relation("UserDeactivatedBy")

    systemAccesses  SystemAccess[]   @relation("SystemAccessUser")
    accessesGranted SystemAccess[]   @relation("SystemAccessGrantedBy")
    accessesRevoked SystemAccess[]   @relation("SystemAccessRevokedBy")
    systemAccounts  SystemAccount[]
    emails          UserEmail[]
    unitAccesses    UserUnitAccess[]
}

enum UserStatus {
    ACTIVE
    INVITED
    INACTIVE
}

// Catálogo de sistemas (analytics, cms, rm, supplies, chat-lhg, helpdesk).
// Dados do launcher do HUB: launchUrl (só https, CHECK no banco; preenchida
// por ambiente quando o sistema for integrado), icon, description e order.
model System {
    key         String   @id
    name        String
    url         String?
    active      Boolean  @default(true)
    launchUrl   String?
    icon        String?
    description String?
    order       Int      @default(0)
    createdAt   DateTime @default(now())

    accesses SystemAccess[]
    accounts SystemAccount[]
    events   AuditEvent[]
}

// Flag de acesso de uma pessoa a um sistema. Revogar = preencher revokedAt
// (o histórico fica). No máximo 1 acesso ATIVO por (userId, systemKey):
// índice único parcial "SystemAccess_active_key" criado por SQL na migration
// (o Prisma não modela índice parcial).
model SystemAccess {
    id          Int       @id @default(autoincrement())
    userId      Int
    systemKey   String
    grantedById Int?
    grantedAt   DateTime  @default(now())
    revokedById Int?
    revokedAt   DateTime?

    user      User   @relation("SystemAccessUser", fields: [userId], references: [id], onDelete: Cascade)
    system    System @relation(fields: [systemKey], references: [key], onDelete: Restrict)
    grantedBy User?  @relation("SystemAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
    revokedBy User?  @relation("SystemAccessRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

    @@index([userId])
}

// Vínculo da pessoa com o id local dela em cada sistema.
model SystemAccount {
    id         Int      @id @default(autoincrement())
    userId     Int
    systemKey  String
    externalId String
    linkedAt   DateTime @default(now())

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    system System @relation(fields: [systemKey], references: [key], onDelete: Restrict)

    @@unique([systemKey, externalId])
    @@unique([userId, systemKey])
}

// E-mails secundários da mesma pessoa (normalizados, como User.email).
model UserEmail {
    id         Int       @id @default(autoincrement())
    userId     Int
    email      String    @unique
    verifiedAt DateTime?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// Multiunidade (uso futuro; o lhg-api continua lendo User.unit).
model UserUnitAccess {
    userId Int
    unit   UserUnit

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([userId, unit])
}

// Trilha de auditoria: só inserção. NUNCA guarda senha, hash ou token.
// Sem FK para User: o evento sobrevive à pessoa (actor/target são só ids).
model AuditEvent {
    id           BigInt   @id @default(autoincrement())
    at           DateTime @default(now())
    actorUserId  Int?
    action       String
    targetUserId Int?
    systemKey    String?
    ip           String?
    userAgent    String?
    metadata     Json?

    system System? @relation(fields: [systemKey], references: [key], onDelete: Restrict)

    @@index([targetUserId, at])
    @@index([action, at])
}

model RefreshToken {
    id        String   @id @default(uuid())
    token     String   @unique
    userId    Int
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    expiresAt DateTime
    createdAt DateTime @default(now())
    revoked   Boolean  @default(false)

    @@index([userId])
    @@index([token])
}

enum UserRole {
    ADMIN
    GERENTE_GERAL
    GERENTE_FINANCEIRO
    GERENTE_RESERVAS
    GERENTE_RESTAURANTE
    GERENTE_OPERACIONAL
}

enum UserUnit {
    LUSH_LAPA
    LUSH_IPIRANGA
    TOUT
    ANDAR_DE_CIMA
    LHG
    LIV
    ALTANA
    GETAN_GARAVELO
    GETAN_PQ_OESTE
    GETAN_INDEPENDENCIA
    GETAN_NOVO_MUNDO
    GETAN_VERA_CRUZ
    GETAN_GRID
}
